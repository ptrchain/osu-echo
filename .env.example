SERVER_HOST=127.0.0.1
SERVER_PORT=5000

# Country code for in-game profile flag (e.g. US, DE, JP, AU)
COUNTRY=

# External API Keys (Recommended)
# Legacy v1 API key for online beatmap leaderboards (https://old.ppy.sh/p/api/)
OSU_API_KEY=

# osudaily API key for real-time global rank calculation (https://osudaily.net/api.php)
OSU_DAILY_API_KEY=

# Optional osu! Account Credentials
# Only needed for '!friend sync' with official Bancho
OSU_USERNAME=
OSU_PASSWORD_HASH=

# Leaderboard Settings
# Show PP instead of Score on beatmap leaderboards
PP_LEADERBOARD=false

# Show PP in the personal best score panel
SHOW_PP_FOR_PERSONAL_BEST=false

# Number of scores shown on leaderboards (1-100)
AMOUNT_OF_SCORES_ON_LB=50

# Chat Feed Settings
# Enable #recent channel feed for submitted scores
ENABLE_RECENT_CHANNEL=true
