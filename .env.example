SERVER_HOST=127.0.0.1
SERVER_PORT=5000

# Important details get hashed during setup
OSU_USERNAME=
OSU_PASSWORD_HASH=

OSU_API_KEY=

OSU_DAILY_API_KEY=

# Leaderboard Settings
# Set to true to show PP values instead of score on leaderboards
PP_LEADERBOARD=false
# Set to true to show PP value for personal best score panel
SHOW_PP_FOR_PERSONAL_BEST=false
# Number of scores shown on leaderboard (1-100)
AMOUNT_OF_SCORES_ON_LB=50

# Chat Feed Settings
# Set to false to disable #recent channel and recent score messages
ENABLE_RECENT_CHANNEL=true

